<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-047 / ADR-019: резервне копіювання Android (Auto Backup) лишається, але копіюються ЛИШЕ дані користувача.
     Усе інше (кеш Coil, ідентифікатори й токени Firebase/App Check, локальний кеш Firestore, база WorkManager) не копіюється. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="flowers_database.db" />
        <include domain="database" path="flowers_database.db-wal" />
        <include domain="database" path="flowers_database.db-shm" />
        <include domain="sharedpref" path="flowers_user_preferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="flowers_database.db" />
        <include domain="database" path="flowers_database.db-wal" />
        <include domain="database" path="flowers_database.db-shm" />
        <include domain="sharedpref" path="flowers_user_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
